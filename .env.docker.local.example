# Local Docker only. Generate unique values; never commit .env.docker.local.
# SQL password must include uppercase, lowercase, a digit and a symbol.
# Avoid semicolons or quotes in SQL passwords because they form part of a connection string.
HELPDESK_SQL_PASSWORD=REPLACE_WITH_A_STRONG_LOCAL_PASSWORD
# At least 32 bytes. Keep stable across container rebuilds.
HELPDESK_JWT_KEY=REPLACE_WITH_A_RANDOM_LOCAL_SIGNING_KEY
HELPDESK_WEB_PORT=8080
HELPDESK_SQL_PORT=14330
