# Windows BIN / HelpDeskDb. The SQL login helpdesk_docker_local must already exist.
HELPDESK_HOST_SQL_PORT=1433
HELPDESK_SQL_PASSWORD=REPLACE_WITH_THE_DEDICATED_SQL_LOGIN_PASSWORD
HELPDESK_JWT_KEY=REPLACE_WITH_A_RANDOM_LOCAL_SIGNING_KEY
HELPDESK_ATTACHMENTS_PATH=C:/Users/YOUR_NAME/AppData/Local/HelpDesk-System/Attachments
HELPDESK_WEB_PORT=8080
