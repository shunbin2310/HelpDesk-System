# Copy privately to /opt/helpdesk-auto/.env, root:root 0600. Never commit real values.
# Use a private server IPv4 address that you have verified is free on port 8085.
HELPDESK_BIND_IP=127.0.0.1
# Prefix Hd1! to 32 random bytes as hex; use this same password for SQL login helpdesk_app.
HELPDESK_SQL_PASSWORD=REPLACE_PRIVATELY
# Generate at least 48 random bytes as hex. Keep the key stable across updates.
HELPDESK_JWT_KEY=REPLACE_PRIVATELY
